{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "arzhilend/arzzaq",
    "type": "project",
    "description": "Aplikasi manajemen zakat musiman Masjid Al-Jihad.",
    "keywords": ["zakat", "laravel", "vue"],
    "license": "proprietary",
    "require": {
        "php": "8.4.*",
        "barryvdh/laravel-dompdf": "3.1.2",
        "laravel/fortify": "1.37.2",
        "laravel/framework": "13.19.0",
        "laravel/horizon": "5.47.2",
        "laravel/reverb": "1.10.2",
        "laravel/sanctum": "4.3.2"
    },
    "require-dev": {
        "fakerphp/faker": "1.24.1",
        "larastan/larastan": "3.10.0",
        "laravel/pint": "1.29.3",
        "mockery/mockery": "1.6.12",
        "nunomaduro/collision": "8.9.4",
        "phpunit/phpunit": "13.2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "npm ci",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan serve"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "format:check": [
            "@php vendor/bin/pint --test"
        ],
        "analyse": [
            "@php vendor/bin/phpstan analyse --no-progress"
        ],
        "quality": [
            "@format:check",
            "@analyse",
            "@test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "abandoned": "fail"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
