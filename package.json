{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "arzzaq",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": "24.18.x",
        "npm": ">=11 <12"
    },
    "packageManager": "npm@11.18.0",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint \"resources/js/**/*.ts\" \"tests/e2e/**/*.ts\" \"playwright.config.ts\" \"vitest.config.ts\" --max-warnings=0",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "typecheck": "tsc --noEmit",
        "openapi:lint": "redocly lint openapi/openapi.yaml",
        "openapi:bundle": "redocly bundle openapi/openapi.yaml --output openapi/dist/openapi.yaml",
        "openapi:types": "openapi-typescript openapi/openapi.yaml --output resources/js/api/schema.d.ts",
        "infra:validate": "node scripts/validate-compose.mjs",
        "infra:health": "node scripts/healthcheck.mjs --wait 180",
        "quality": "npm run lint && npm run typecheck && npm run test && npm run openapi:lint && npm run build"
    },
    "dependencies": {
        "vue": "3.5.41"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.62.1",
        "@redocly/cli": "2.46.2",
        "@tailwindcss/vite": "4.3.3",
        "@types/node": "26.2.0",
        "eslint": "10.8.1",
        "eslint-plugin-vue": "10.10.0",
        "laravel-vite-plugin": "3.2.0",
        "openapi-typescript": "7.13.0",
        "tailwindcss": "4.3.3",
        "typescript": "7.0.2",
        "typescript-eslint": "8.67.0",
        "vite": "8.2.2",
        "vitest": "4.1.11"
    }
}
